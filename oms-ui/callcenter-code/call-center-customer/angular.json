{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "yarn",
    "schematicCollections": ["@angular-eslint/schematics"]
  },
  "newProjectRoot": "packages",
  "projects": {
    "customer-shared": {
      "projectType": "library",
      "root": "packages/customer-shared",
      "sourceRoot": "packages/customer-shared/src",
      "prefix": "call-center",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "packages/customer-shared/tsconfig.lib.json",
            "project": "packages/customer-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "packages/customer-shared/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "packages/customer-shared/src/test.ts",
            "tsConfig": "packages/customer-shared/tsconfig.spec.json",
            "karmaConfig": "packages/customer-shared/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "packages/customer-shared/**/*.ts",
              "packages/customer-shared/**/*.html"
            ]
          }
        }
      }
    },
    "customer-create": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "inlineStyle": true,
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:module": {},
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "packages/customer-create",
      "sourceRoot": "packages/customer-create/src",
      "prefix": "call-center",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/call-center-customer/customer-create",
            "index": "packages/customer-create/src/index.html",
            "main": "packages/customer-create/src/main.single-spa.ts",
            "polyfills": "packages/customer-create/src/polyfills.ts",
            "tsConfig": "packages/customer-create/tsconfig.app.json",
            "aot": true,
            "preserveSymlinks": true,
            "assets": [
              "packages/customer-create/src/favicon.ico",
              "packages/customer-create/src/assets"
            ],
            "styles": ["packages/customer-create/src/styles.scss"],
            "scripts": [],
            "customWebpackConfig": {
              "path": "extra-webpack.config.js",
              "libraryName": "customer-create",
              "libraryTarget": "umd"
            },
            "deployUrl": "/call-center-customer/customer-create/",
            "stylePreprocessorOptions": {
              "includePaths": ["packages/customer-create/src/assets/scss"]
            }
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "packages/customer-create/src/environments/environment.ts",
                  "with": "packages/customer-create/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "merged": {
              "outputPath": "dist/call-center-customer/customer-create",
              "index": "packages/customer-create/src-merged/index.html",
              "main": "packages/customer-create/src-merged/main.single-spa.ts",
              "polyfills": "packages/customer-create/src-merged/polyfills.ts",
              "tsConfig": "packages/customer-create/tsconfig.app.merged.json",
              "aot": true,
              "preserveSymlinks": true,
              "assets": [
                {
                  "glob": "**",
                  "input": "packages/customer-create/src-merged/assets",
                  "output": "assets"
                },
                {
                  "glob": "*.json",
                  "input": "packages/customer-create/src-merged/assets/call-center-customer",
                  "output": "assets/customer-create"
                },
                {
                  "glob": "**",
                  "input": "node_modules/@buc/svc-angular/assets",
                  "output": "assets"
                },
                {
                  "glob": "**",
                  "input": "node_modules/@buc/common-components/assets",
                  "output": "assets"
                }
              ],
              "styles": ["packages/customer-create/src-merged/styles.scss"],
              "scripts": [],
              "customWebpackConfig": {
                "path": "extra-webpack.config.js",
                "libraryName": "customer-create",
                "libraryTarget": "umd"
              },
              "deployUrl": "/call-center-customer/customer-create/",
              "stylePreprocessorOptions": {
                "includePaths": [
                  "packages/customer-create/src-merged/assets/scss"
                ]
              },
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "merged-prod": {
              "outputPath": "dist/call-center-customer/customer-create",
              "index": "packages/customer-create/src-merged/index.html",
              "main": "packages/customer-create/src-merged/main.single-spa.ts",
              "polyfills": "packages/customer-create/src-merged/polyfills.ts",
              "tsConfig": "packages/customer-create/tsconfig.app.merged.json",
              "aot": true,
              "preserveSymlinks": true,
              "assets": [
                {
                  "glob": "**",
                  "input": "packages/customer-create/src-merged/assets",
                  "output": "assets"
                },
                {
                  "glob": "*.json",
                  "input": "packages/customer-create/src-merged/assets/call-center-customer",
                  "output": "assets/customer-create"
                },
                {
                  "glob": "**",
                  "input": "node_modules/@buc/svc-angular/assets",
                  "output": "assets"
                },
                {
                  "glob": "**",
                  "input": "node_modules/@buc/common-components/assets",
                  "output": "assets"
                }
              ],
              "styles": ["packages/customer-create/src-merged/styles.scss"],
              "scripts": [],
              "customWebpackConfig": {
                "path": "extra-webpack.config.js",
                "libraryName": "customer-create",
                "libraryTarget": "umd"
              },
              "deployUrl": "/call-center-customization/call-center-customer/customer-create/",
              "stylePreprocessorOptions": {
                "includePaths": [
                  "packages/customer-create/src-merged/assets/scss"
                ]
              },
              "buildOptimizer": true,
              "optimization": true,
              "vendorChunk": false,
              "extractLicenses": true,
              "sourceMap": false,
              "namedChunks": false,
              "fileReplacements": [
                {
                  "replace": "packages/customer-create/src-merged/environments/environment.ts",
                  "with": "packages/customer-create/src-merged/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "none",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "buildTarget": "customer-create:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "customer-create:build:production"
            },
            "development": {
              "buildTarget": "customer-create:build:development"
            },
            "merged": {
              "buildTarget": "customer-create:build:merged"
            },
            "merged-prod": {
              "buildTarget": "customer-create:build-merged-prod"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "customer-create:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "packages/customer-create/**/*.ts",
              "packages/customer-create/**/*.html"
            ]
          }
        }
      }
    },
