<mashups>
	<mashup
		description="This mashup is called to fetch the Decrypted Givex Details while loading the ordersummary payment tab"
		id="icc.order.summary.getDecryptedGivexDetails" mashuptype="XAPI"
		transactional="true" skipDataProvider="true">
		<classInformation name="com.ibm.icc.common.mashups.ICCBaseMashup" />
		<API FlowName="CrocsDecryptGivexDetails">
			<Input>
				<PaymentMethod SvcNo="" PaymentType="">
				</PaymentMethod>
			</Input>
			<Template>
				<PaymentMethod SvcNo="" PaymentType="">
				</PaymentMethod>
			</Template>
		</API>
	</mashup>
	
	<mashup
		description="This mashup is update the selected order reason from call center screen"
		id="icc.order.summary.updateReasonCode" mashuptype="XAPI"
		transactional="true" skipDataProvider="true">
		<classInformation name="com.ibm.icc.common.mashups.ICCBaseMashup" />
		<API Name="changeOrder">
			<Input>
				<Order Action="" DocumentType="" EnterpriseCode="" OrderHeaderKey="">
					<Extn ExtnReasonCode=""/>
				</Order>
			</Input>
			<Template>
				<Order DraftOrderFlag="" EnterpriseCode="" OrderHeaderKey="" />
			</Template>
		</API>
	</mashup>
	
	<mashup
		description="This mashup updates the selected cost center from call center screen"
		id="icc.order.summary.updateCostCenter" mashuptype="XAPI"
		transactional="true" skipDataProvider="true">
		<classInformation name="com.ibm.icc.common.mashups.ICCBaseMashup" />
		<API Name="changeOrder">
			<Input>
				<Order Action="" DocumentType="" EnterpriseCode="" OrderHeaderKey="">
					<Extn ExtnCostCenter=""/>
				</Order>
			</Input>
			<Template>
				<Order DraftOrderFlag="" EnterpriseCode="" OrderHeaderKey="" />
			</Template>
		</API>
	</mashup>
</mashups>